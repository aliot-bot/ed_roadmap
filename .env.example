# Public DNS name. Point its A/AAAA record at the VPS before starting Caddy.
DOMAIN=roadmap.example.com

# Compose/PostgreSQL settings. POSTGRES_PASSWORD is interpolated into a URL, so
# use an URL-safe value such as `openssl rand -hex 32`. Keep the real .env only
# on the VPS, with mode 0600; it is ignored by Git.
COMPOSE_PROJECT_NAME=knowledge-map
POSTGRES_DB=knowledge_map
POSTGRES_USER=knowledge_map
POSTGRES_PASSWORD=replace-with-output-of-openssl-rand-hex-32

# Backend runtime.
APP_ENV=production
LOG_LEVEL=info
HTTP_ADDR=:8080
DATABASE_MAX_CONNS=10
SESSION_TTL=24h
ACCESS_KEY_PEPPER=replace-with-a-separate-long-random-secret
ALLOW_BOOTSTRAP=false
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# MCP operations run as this owner after the one-time account bootstrap.
OWNER_LOGIN=owner@example.com

# Trusted/private MCP mode. A static token is suitable only for a deliberately
# limited trusted client; it is not ChatGPT OAuth compatibility. Rotate/revoke
# it when the trusted client changes.
MCP_ENABLED=true
MCP_STATIC_TOKEN=replace-with-output-of-openssl-rand-hex-32
MCP_SCOPES=roadmaps:read,roadmaps:write
MCP_MAX_BATCH_TOPICS=100
